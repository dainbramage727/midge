{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dainbramage727/midge/data/schema.json",
  "title": "Midge NL-to-action example",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "split", "category", "subcategory", "utterance", "context_ref", "target", "expected_behavior", "reason", "sft_eligible", "tags", "provenance", "template_id", "semantic_group"],
  "properties": {
    "id": {"type": "string", "pattern": "^midge-(tra|val|tes|gold)-[0-9]{3,4}$"},
    "split": {"enum": ["train", "validation", "test", "gold"]},
    "category": {"type": "string", "minLength": 1},
    "subcategory": {"type": "string", "minLength": 1},
    "utterance": {"type": "string", "minLength": 1},
    "context_ref": {"type": "string", "minLength": 1},
    "target": {"type": ["object", "null"]},
    "expected_behavior": {"enum": ["execute", "clarify", "reject"]},
    "reason": {"type": ["string", "null"]},
    "sft_eligible": {"type": "boolean"},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "provenance": {"enum": ["synthetic", "handwritten"]},
    "template_id": {"type": "string", "minLength": 1},
    "semantic_group": {"type": "string", "minLength": 1}
  }
}
